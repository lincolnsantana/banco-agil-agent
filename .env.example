# Provedor LLM
BANCO_AGIL_GROQ_API_KEY=
BANCO_AGIL_GROQ_MODEL=llama-3.3-70b-versatile
BANCO_AGIL_LLM_TEMPERATURE=0.3
BANCO_AGIL_LLM_MAX_TOKENS=500
BANCO_AGIL_LLM_TIMEOUT_SECONDS=30

# Integracoes e armazenamento local
BANCO_AGIL_AWESOMEAPI_BASE_URL=https://economia.awesomeapi.com.br
# Opcional. Sem token a cota da AwesomeAPI e por IP, o que estoura em hospedagem
# de IP compartilhado. Gere o seu em https://awesomeapi.com.br
BANCO_AGIL_AWESOMEAPI_TOKEN=
BANCO_AGIL_DATA_DIR=data
BANCO_AGIL_VAR_DIR=var
